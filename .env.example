PORT=3000
MONGODB_URI=mongodb://localhost:27017/dacn1

# Auth (Milestone 1)
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Google login (Milestone 1)
GOOGLE_CLIENT_ID=

# AI service (Milestone 3)
# Prefer these (AiService reads both new + legacy keys):
# AI_MODERATION_URL=http://127.0.0.1:8000/moderate
# AI_MODERATION_TIMEOUT_MS=5000
# Legacy keys (still supported):
AI_SERVICE_URL=http://127.0.0.1:8000/moderate
AI_TIMEOUT_MS=5000
AI_TOXIC_THRESHOLD=0.7
AI_VERSION=phobert-multitask

# Gemini API key for comment digest summarization
# Get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Hot keywords/topics workers (reduce AI spam in dev)
HOT_KEYWORDS_INTERVAL_MS=300000
HOT_KEYWORDS_TREND_COOLDOWN_MS=600000
HOT_TOPICS_INTERVAL_MS=300000
HOT_TOPICS_TREND_COOLDOWN_MS=600000

# AI moderation 3-zone routing:
#   toxic_score >= AI_TOXIC_THRESHOLD      → auto rejected
#   toxic_score >= AI_TOXIC_REVIEW_THRESHOLD → under_review (admin check)
#   confidence  <  AI_CONFIDENCE_THRESHOLD → under_review (model unsure)
#   otherwise                              → auto approved
AI_TOXIC_REVIEW_THRESHOLD=0.4
AI_CONFIDENCE_THRESHOLD=0.6

# RSS import (Milestone 4) - comma-separated RSS URLs
RSS_SOURCES=

# Matches (Milestone 10) — set MATCH_DATA_PROVIDER=mock to use built-in mock data during dev
MATCH_DATA_PROVIDER=mock
PANDASCORE_TOKEN=
MATCH_SYNC_INTERVAL_MS=300000

# Kalstrop Odds API (https://dev.kalstrop.com/docs)
KALSTROP_CLIENT_ID=
KALSTROP_SHARED_SECRET=

# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

